# Earshot — environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# === LLM (Anthropic) ============================================
# Get a key at https://console.anthropic.com/. Required from module 4 onward.
ANTHROPIC_API_KEY=

# === Email delivery (Yahoo SMTP) ================================
# YAHOO_EMAIL: the address that will be the sender (your Yahoo account).
# YAHOO_APP_PASSWORD: generate at https://login.yahoo.com → Account Security
#   → "Generate and manage app passwords". Do NOT use your login password.
# DIGEST_RECIPIENT: where the digest gets delivered.
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
DIGEST_RECIPIENT=a_alkishawi@yahoo.com

# === ASR (Groq Whisper) — module 3 onward =======================
# Free tier at https://console.groq.com/. Used as audio fallback when YouTube
# captions are unavailable.
GROQ_API_KEY=

# === Paths ======================================================
EARSHOT_DB_PATH=earshot.db
EARSHOT_DATA_DIR=data

# === Scheduling =================================================
DIGEST_TIMEZONE=America/New_York
DIGEST_HOUR=12

# === Digest thresholds ==========================================
# News importance score (1-5). Items at or above DIGEST_MIN_NEWS_SCORE go in
# the daily digest. Items at or above INSTANT_MIN_NEWS_SCORE fire an instant
# alert immediately and are excluded from the daily digest.
DIGEST_MIN_NEWS_SCORE=3
INSTANT_MIN_NEWS_SCORE=5

# === Observability + cost controls ==============================
LOG_LEVEL=INFO
MAX_LLM_COST_PER_RUN_USD=2.00
